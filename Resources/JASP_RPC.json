{
	"openrpc": "1.2.6",
	"info": {
		"title": "JASP RPC API",
		"version": "1.0.0"
	},
	"methods": [
		{
			"name": "analysis.create",
			"summary": "Create and start an analysis by module name and analysis name.",
			"params": [
				{
					"name": "module",
					"required": true,
					"description": "JASP module name, e.g. 'jaspTTests'.",
					"schema": { "type": "string" }
				},
				{
					"name": "analysis",
					"required": true,
					"description": "Analysis name within the module, e.g. 'TTestIndependent'.",
					"schema": { "type": "string" }
				}
			],
			"result": {
				"name": "analysis.create.result",
				"description": "Metadata about the created analysis.",
				"schema": {
					"type": "object",
					"properties": {
						"status": {
							"type": "string",
							"description": "Always 'success' when the analysis was created."
						},
						"analysisId": {
							"type": "integer",
							"description": "Unique integer identifier for the new analysis."
						},
						"module": {
							"type": "string",
							"description": "The module name, echoed back."
						},
						"analysis": {
							"type": "string",
							"description": "The analysis name, echoed back."
						}
					},
					"required": ["status", "analysisId", "module", "analysis"]
				}
			}
		},
		{
			"name": "analysis.setOptions",
			"summary": "Set analysis options for an existing analysis by ID.",
			"params": [
				{
					"name": "analysisId",
					"required": true,
					"description": "The integer identifier of the analysis to modify.",
					"schema": { "type": "integer" }
				},
				{
					"name": "options",
					"required": true,
					"description": "An object of option name/value pairs to set on the analysis.",
					"schema": { "type": "object" }
				}
			],
			"result": {
				"name": "analysis.setOptions.result",
				"description": "Confirmation that the options were applied.",
				"schema": {
					"type": "object",
					"properties": {
						"status": {
							"type": "string",
							"description": "Always 'success' when the options were set."
						},
						"analysisId": {
							"type": "integer",
							"description": "The analysis identifier."
						},
						"module": {
							"type": "string",
							"description": "The module name."
						},
						"analysis": {
							"type": "string",
							"description": "The analysis name."
						}
					},
					"required": ["status", "analysisId", "module", "analysis"]
				}
			}
		},
		{
			"name": "analysis.getOptions",
			"summary": "Retrieve the current analysis options by analysis ID.",
			"params": [
				{
					"name": "analysisId",
					"required": true,
					"description": "The integer identifier of the analysis to query.",
					"schema": { "type": "integer" }
				}
			],
			"result": {
				"name": "analysis.getOptions.result",
				"description": "The current options of the analysis.",
				"schema": {
					"type": "object",
					"properties": {
						"status": {
							"type": "string",
							"description": "Always 'success' when the options were retrieved."
						},
						"analysisId": {
							"type": "integer",
							"description": "The analysis identifier."
						},
						"module": {
							"type": "string",
							"description": "The module name."
						},
						"analysis": {
							"type": "string",
							"description": "The analysis name."
						},
						"options": {
							"type": "object",
							"description": "The current analysis options."
						}
					},
					"required": [
						"status",
						"analysisId",
						"module",
						"analysis",
						"options"
					]
				}
			}
		},
		{
			"name": "modules.list",
			"summary": "List all loaded modules and their available analyses.",
			"params": [],
			"result": {
				"name": "modules.list.result",
				"schema": {
					"type": "object",
					"properties": {
						"modules": {
							"type": "array",
							"description": "All currently loaded modules.",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string",
										"description": "Module name, e.g. 'jaspTTests'."
									},
									"title": {
										"type": "string",
										"description": "Human-readable module title, e.g. 'T-Tests'."
									},
									"analyses": {
										"type": "array",
										"description": "Available analyses in this module.",
										"items": {
											"type": "object",
											"properties": {
												"name": {
													"type": "string",
													"description": "Analysis function name, e.g. 'TTestIndependentSamples'."
												},
												"title": {
													"type": "string",
													"description": "Human-readable analysis title, e.g. 'Independent Samples T-Test'."
												}
											},
											"required": ["name", "title"]
										}
									}
								},
								"required": ["name", "title", "analyses"]
							}
						}
					},
					"required": ["modules"]
				}
			}
		},
		{
			"name": "ping",
			"summary": "Simple connectivity check. Always returns pong.",
			"params": [],
			"result": {
				"name": "ping.result",
				"schema": {
					"type": "object",
					"properties": {
						"message": {
							"type": "string",
							"description": "Always 'pong'."
						}
					},
					"required": ["message"]
				}
			}
		},
		{
			"name": "rpc.discover",
			"summary": "Schema discovery. Returns the names of all registered RPC methods.",
			"params": [],
			"result": {
				"name": "rpc.discover.result",
				"schema": {
					"type": "object",
					"properties": {
						"methods": {
							"type": "array",
							"description": "List of registered method name strings.",
							"items": { "type": "string" }
						}
					},
					"required": ["methods"]
				}
			}
		}
	]
}
